# ─────────────────────────────────────────────────────────────────────────
# Test environment — copy to .env.test (which is gitignored).
#
# These point at the ISOLATED local Postgres test database defined in
# docker-compose.test.yml (started by `make test-prepare`). The test suite
# wipes every table between cases, so these must NEVER point at production.
# vitest.config.ts requires DATABASE_URL_TEST and refuses to fall back to the
# production DATABASE_URL; tests/setup.ts additionally refuses any non-local /
# non-"test" database. Both guards exist to make an accidental prod wipe
# impossible.
# ─────────────────────────────────────────────────────────────────────────

DATABASE_URL_TEST=postgresql://test:test@localhost:5433/ahits_test
DIRECT_URL_TEST=postgresql://test:test@localhost:5433/ahits_test
