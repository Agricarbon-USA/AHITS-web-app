From 223690ada99aaf67cc2cedd705bbed060d7783a4 Mon Sep 17 00:00:00 2001
From: maxwellslater <maxtslater@gmail.com>
Date: Tue, 7 Jul 2026 11:36:16 -0600
Subject: [PATCH] test(photo-security): make ur005b deterministic vs ambient
 NEXT_PUBLIC_SUPABASE_URL
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The ur005b unit test fails on development whenever a real NEXT_PUBLIC_SUPABASE_URL
is present in the test env (.env sets the live project host). isAllowedPhotoUrl
captured that host in a module-level const at import time and compares photo-URL
hosts against it, so the abc.supabase.co fixtures were rejected (real host != abc).

Read the env at call time inside isAllowedPhotoUrl (behavior-identical in prod:
NEXT_PUBLIC_SUPABASE_URL is a runtime Cloud Run secret, not build-inlined, and this
file is server-side — module-load and call-time reads return the same value), so the
test can vi.stubEnv the host to match its fixtures. Adds a note that the generic
.supabase.co fallback must never be the prod path.

3-agent review (antagonist): confirmed safe no-op in production (Makefile:136 runtime
secret; Dockerfile has no build ARG; server-side process.env is live) and traced every
assertion green. NOTE: sandbox can't run the Prisma/vitest suite (platform+network) —
CI must confirm ur005b now passes.
---
 src/lib/photo-security.ts        | 15 ++++++++++-----
 tests/ur005b-photo-proxy.test.ts |  9 ++++++++-
 2 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/src/lib/photo-security.ts b/src/lib/photo-security.ts
index 2269363..20d4ecd 100644
--- a/src/lib/photo-security.ts
+++ b/src/lib/photo-security.ts
@@ -7,8 +7,6 @@
 // content-injection / phishing vector. We persist only URLs that point at our
 // own Supabase storage object endpoint.
 
-const SUPABASE_URL = process.env.NEXT_PUBLIC_SUPABASE_URL ?? ''
-
 // UR-005b: photos live in a PRIVATE bucket. They are never rendered from a public
 // Supabase URL; instead every reference is rewritten to the auth-gated proxy
 // `/api/photos/<object-path>` (see src/app/api/photos/[...path]/route.ts), which
@@ -71,14 +69,21 @@ export function isAllowedPhotoUrl(url: unknown): url is string {
   if (u.protocol !== 'https:') return false
   // Must hit a Supabase storage object path (…/storage/v1/object/{public|sign}/…).
   if (!u.pathname.includes('/storage/v1/object/')) return false
-  if (SUPABASE_URL) {
+  // Read at call time (not module load) so the check is deterministic under test.
+  // In production Next.js inlines NEXT_PUBLIC_* at build time, so this is a constant
+  // either way — no runtime behavior change; it only makes the host allowlist stubbable.
+  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL ?? ''
+  if (supabaseUrl) {
     try {
-      return u.host === new URL(SUPABASE_URL).host
+      return u.host === new URL(supabaseUrl).host
     } catch {
       /* fall through to the generic host check */
     }
   }
-  // No configured origin (tests/local) — require a Supabase-hosted bucket.
+  // No configured origin (tests/local) — require a Supabase-hosted bucket. NOTE: this
+  // generic fallback is deliberately looser and must NEVER be the production path:
+  // NEXT_PUBLIC_SUPABASE_URL is a required Cloud Run runtime secret (Makefile env-check
+  // hard-fails without it), so prod always takes the strict host-equality branch above.
   return u.hostname.endsWith('.supabase.co')
 }
 
diff --git a/tests/ur005b-photo-proxy.test.ts b/tests/ur005b-photo-proxy.test.ts
index fe46291..903192b 100644
--- a/tests/ur005b-photo-proxy.test.ts
+++ b/tests/ur005b-photo-proxy.test.ts
@@ -1,6 +1,13 @@
-import { describe, it, expect } from 'vitest'
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
 import { extractStoragePath, toPhotoSrc, isAllowedPhotoUrl } from '../src/lib/photo-security'
 
+// isAllowedPhotoUrl checks the photo host against NEXT_PUBLIC_SUPABASE_URL. Pin it to
+// the fixtures' host so the allowlist assertions are deterministic regardless of the
+// ambient env (a real Supabase URL in .env would otherwise reject the abc.supabase.co
+// fixtures). Read at call time in the source, so a plain stubEnv is sufficient.
+beforeEach(() => { vi.stubEnv('NEXT_PUBLIC_SUPABASE_URL', 'https://abc.supabase.co') })
+afterEach(() => { vi.unstubAllEnvs() })
+
 // UR-005b: photos live in a PRIVATE bucket and render only through the auth-gated
 // proxy `/api/photos/<path>`. These helpers must (a) resolve any reference form to
 // the bucket object path, (b) rewrite references to the proxy URL for rendering,
-- 
