 .../api/deployments/[id]/operators/route.ts   | 31 +++++++++++++------
 .../api/deployments/[id]/vehicles/route.ts    | 10 ++++++
 src/app/api/deployments/route.ts              | 10 ++++++
 src/app/api/transfers/[id]/decline/route.ts   | 15 +++++++++
 src/app/api/transfers/[id]/route.ts           | 28 +++++++++++++++++
 7 files changed, 133 insertions(+), 10 deletions(-)
