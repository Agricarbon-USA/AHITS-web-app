 src/app/(admin)/admin/deployments/page.tsx | 31 ++++++++++++++-----
 src/app/(admin)/admin/requests/page.tsx    | 36 ++++++++++++++++------
 2 files changed, 50 insertions(+), 17 deletions(-)

