generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  OPERATOR
}

enum VehicleType {
  TRUCK
  TRAILER
  POLARIS_UTV
  CAN_AM_UTV
  CHRISTIE_DRILL
  ATV
  OTHER
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

enum EquipmentStatus {
  AVAILABLE
  CHECKED_OUT
  IN_MAINTENANCE
  INOPERABLE
  RETIRED
}

enum RepairType {
  IN_FIELD
  AT_SHOP
  SHIP_TO_HUB
  SHIP_FOR_REPAIR
}

enum CheckAction {
  CHECK_OUT
  CHECK_IN
}

enum Condition {
  GOOD
  MINOR_DAMAGE
  NEEDS_REPAIR
  MISSING_PARTS
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum MaintenanceStatus {
  UPCOMING
  DUE_SOON
  OVERDUE
  IN_PROGRESS
  COMPLETED
}

enum IntervalType {
  MILEAGE
  DAYS
  MONTHS
  PER_DEPLOYMENT
}

enum ProjectType {
  CROPLAND
  RANGELAND
  FORESTRY
  OTHER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum AlertType {
  MAINTENANCE_OVERDUE
  EQUIPMENT_NOT_RETURNED
  DAMAGE_REPORTED
  REPAIR_NEEDED
  LOW_INVENTORY
  INSURANCE_EXPIRING
  REGISTRATION_EXPIRING
  PIN_LOCKED
}

enum PhotoContext {
  DAMAGE
  DAILY_CHECK
  MAINTENANCE
  INVENTORY_REFERENCE
  VEHICLE_REFERENCE
}

enum ItemType {
  SERIALIZED
  CONSUMABLE
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Models ───────────────────────────────────────────────────────

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  role              UserRole     @default(OPERATOR)
  pinHash           String?
  failedPinAttempts Int          @default(0)
  pinLockedAt       DateTime?
  isActive          Boolean      @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  checkLogs         CheckLog[]
  dailyChecks       DailyCheck[]
  projectsLed       Project[]    @relation("ProjectLead")
  photos            Photo[]
  alerts            Alert[]
  rigs               Rig[]             @relation("OperatorRigs")
  transfersReceived  TransferRequest[] @relation("TransferTo")
  transfersInitiated TransferRequest[] @relation("TransferBy")
  inoperableReports  InventoryItem[]   @relation("InoperableReports")

  @@map("users")
}

model Category {
  id        String          @id @default(cuid())
  name      String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  items     InventoryItem[]

  @@map("categories")
}

model Hub {
  id          String            @id @default(cuid())
  name        String
  city        String
  state       String
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  items       InventoryItem[]
  repairTasks MaintenanceTask[]

  @@map("hubs")
}

model Rig {
  id         String     @id @default(cuid())
  label      String?
  operatorId String
  operator   User       @relation("OperatorRigs", fields: [operatorId], references: [id])
  projectId  String?
  project    Project?   @relation(fields: [projectId], references: [id])
  startedAt  DateTime   @default(now())
  endedAt    DateTime?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  vehicles          RigVehicle[]
  kits              Kit[]
  outgoingTransfers TransferRequest[] @relation("FromRig")

  @@map("rigs")
}

model RigVehicle {
  id         String    @id @default(cuid())
  rigId      String
  vehicleId  String
  rig        Rig       @relation(fields: [rigId], references: [id])
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
  addedAt    DateTime  @default(now())
  addNote    String
  removedAt  DateTime?
  removeNote String?
  photoUrls  String[]  @default([])

  @@map("rig_vehicles")
}

model Kit {
  id        String    @id @default(cuid())
  rigId     String
  rig       Rig       @relation(fields: [rigId], references: [id])
  label     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items     KitItem[]

  @@map("kits")
}

model KitItem {
  id              String        @id @default(cuid())
  kitId           String
  inventoryItemId String
  quantity        Int           @default(1)
  kit             Kit           @relation(fields: [kitId], references: [id])
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id])
  addedAt         DateTime      @default(now())
  removedAt       DateTime?

  transferItems TransferItem[]

  @@map("kit_items")
}

model TransferRequest {
  id             String         @id @default(cuid())
  fromRigId      String
  fromRig        Rig            @relation("FromRig", fields: [fromRigId], references: [id])
  toOperatorId   String
  toOperator     User           @relation("TransferTo", fields: [toOperatorId], references: [id])
  initiatedById  String
  initiatedBy    User           @relation("TransferBy", fields: [initiatedById], references: [id])
  note           String
  photoUrls      String[]       @default([])
  status         TransferStatus @default(PENDING)
  responseNote   String?
  respondedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vehicles TransferVehicle[]
  items    TransferItem[]

  @@map("transfer_requests")
}

model TransferVehicle {
  id                String          @id @default(cuid())
  transferRequestId String
  vehicleId         String
  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id])
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])

  @@map("transfer_vehicles")
}

model TransferItem {
  id                String          @id @default(cuid())
  transferRequestId String
  kitItemId         String
  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id])
  kitItem           KitItem         @relation(fields: [kitItemId], references: [id])

  @@map("transfer_items")
}

model InventoryItem {
  id                String          @id @default(cuid())
  name              String
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  hubId             String?
  hub               Hub?            @relation(fields: [hubId], references: [id])
  sku               String?
  quantity          Int             @default(1)
  unitCost          Decimal?        @db.Decimal(10, 2)
  reorderUrl        String?
  supplier          String?
  status            EquipmentStatus @default(AVAILABLE)
  location          String?
  qrCodeId          String          @unique @default(cuid())
  notes                  String?
  lowStockThreshold      Int?
  itemType               ItemType        @default(CONSUMABLE)
  unitId                 String?
  expectedQuantity       Int?
  inoperableNotes        String?
  inoperableReportedAt   DateTime?
  inoperableReportedById String?
  inoperableReportedBy   User?           @relation("InoperableReports", fields: [inoperableReportedById], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  checkLogs        CheckLog[]
  photos           Photo[]
  maintenanceTasks MaintenanceTask[]
  projectEquipment ProjectEquipment[]
  kitItems         KitItem[]

  @@map("inventory_items")
}

model Vehicle {
  id                  String        @id @default(cuid())
  name                String        @unique
  type                VehicleType
  year                Int?
  makeModel           String?
  vin                 String?       @unique
  licensePlate        String?
  odometer            Int?
  status              VehicleStatus @default(ACTIVE)
  location            String?
  assignedOperatorId  String?
  insuranceExpires    DateTime?
  registrationExpires DateTime?
  qrCodeId            String        @unique @default(cuid())
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  dailyChecks      DailyCheck[]
  maintenanceTasks MaintenanceTask[]
  photos           Photo[]
  rigVehicles      RigVehicle[]
  transferVehicles TransferVehicle[]

  @@map("vehicles")
}

model DailyCheck {
  id            String    @id @default(cuid())
  vehicleId     String
  operatorId    String
  date          DateTime  @db.Date
  site          String?
  odometer      Int?
  checklistJson Json
  issues        String?
  passFail      Boolean   @default(true)
  submittedAt   DateTime  @default(now())
  syncedAt      DateTime?

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  operator User     @relation(fields: [operatorId], references: [id])
  photos   Photo[]

  @@unique([vehicleId, date, operatorId])
  @@map("daily_checks")
}

model CheckLog {
  id             String      @id @default(cuid())
  action         CheckAction
  itemId         String
  operatorId     String?
  projectId      String?
  fromLocation   String?
  toLocation     String?
  condition      Condition?
  expectedReturn DateTime?
  actualReturn   DateTime?
  notes          String?
  submittedAt    DateTime    @default(now())
  syncedAt       DateTime?

  item     InventoryItem @relation(fields: [itemId], references: [id])
  operator User?         @relation(fields: [operatorId], references: [id])
  project  Project?      @relation(fields: [projectId], references: [id])
  photos   Photo[]

  @@map("check_logs")
}

model MaintenanceTask {
  id             String            @id @default(cuid())
  vehicleId      String?
  itemId         String?
  taskName       String
  intervalType   IntervalType?
  intervalValue  Int?
  isDamageReport Boolean           @default(false)
  repairType     RepairType?
  shopName       String?
  shopAddress    String?
  dateDelivered  DateTime?
  purchaseOrder  String?
  invoiceNumber  String?
  repairHubId    String?
  priority       Priority          @default(MEDIUM)
  lastCompleted  DateTime?
  lastOdometer   Int?
  nextDue        DateTime?
  nextOdometer   Int?
  status         MaintenanceStatus @default(UPCOMING)
  estimatedCost  Decimal?          @db.Decimal(10, 2)
  actualCost     Decimal?          @db.Decimal(10, 2)
  assigneeId     String?
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  vehicle   Vehicle?          @relation(fields: [vehicleId], references: [id])
  item      InventoryItem?    @relation(fields: [itemId], references: [id])
  repairHub Hub?              @relation(fields: [repairHubId], references: [id])
  photos    Photo[]

  @@map("maintenance_tasks")
}

model Project {
  id        String        @id @default(cuid())
  name      String
  type      ProjectType   @default(CROPLAND)
  location  String?
  startDate DateTime?     @db.Date
  endDate   DateTime?     @db.Date
  status    ProjectStatus @default(PLANNED)
  leadId    String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lead      User?              @relation("ProjectLead", fields: [leadId], references: [id])
  checkLogs CheckLog[]
  equipment ProjectEquipment[]
  rigs      Rig[]

  @@map("projects")
}

model ProjectEquipment {
  projectId String
  itemId    String

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])

  @@id([projectId, itemId])
  @@map("project_equipment")
}

model Alert {
  id          String    @id @default(cuid())
  type        AlertType
  triggeredAt DateTime  @default(now())
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  adminId     String?
  sourceTable String?
  sourceId    String?
  metadata    Json?

  admin User? @relation(fields: [adminId], references: [id])

  @@map("alerts")
}

model Photo {
  id              String       @id @default(cuid())
  url             String
  thumbnailUrl    String?
  context         PhotoContext
  dailyCheckId    String?
  checkLogId      String?
  maintenanceId   String?
  inventoryItemId String?
  vehicleId       String?
  uploadedById    String
  takenAt         DateTime     @default(now())
  gpsLat          Float?
  gpsLng          Float?

  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  dailyCheck      DailyCheck?      @relation(fields: [dailyCheckId], references: [id])
  checkLog        CheckLog?        @relation(fields: [checkLogId], references: [id])
  maintenanceTask MaintenanceTask? @relation(fields: [maintenanceId], references: [id])
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])

  @@map("photos")
}

model InviteToken {
  id        String    @id @default(cuid())
  email     String
  role      UserRole
  name      String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String

  @@map("invite_tokens")
}
