generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  OPERATOR
}

enum VehicleType {
  TRUCK
  TRAILER
  POLARIS_UTV
  CAN_AM_UTV
  CHRISTIE_DRILL
  ATV
  OTHER
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

enum EquipmentCategory {
  SAMPLING_EQUIPMENT
  POWER_TOOLS
  HAND_TOOLS
  SAFETY_GEAR
  ELECTRONICS_GPS
  STORAGE
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  CHECKED_OUT
  IN_MAINTENANCE
  INOPERABLE
  RETIRED
}

enum RepairType {
  IN_FIELD
  AT_SHOP
  SHIP_TO_HUB
  SHIP_FOR_REPAIR
}

enum CheckAction {
  CHECK_OUT
  CHECK_IN
}

enum Condition {
  GOOD
  MINOR_DAMAGE
  NEEDS_REPAIR
  MISSING_PARTS
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum MaintenanceStatus {
  UPCOMING
  DUE_SOON
  OVERDUE
  IN_PROGRESS
  COMPLETED
}

enum IntervalType {
  MILEAGE
  DAYS
  MONTHS
  PER_DEPLOYMENT
}

enum ProjectType {
  CROPLAND
  RANGELAND
  FORESTRY
  OTHER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum AlertType {
  MAINTENANCE_OVERDUE
  EQUIPMENT_NOT_RETURNED
  DAMAGE_REPORTED
  REPAIR_NEEDED
  LOW_INVENTORY
  INSURANCE_EXPIRING
  REGISTRATION_EXPIRING
  PIN_LOCKED
}

enum PhotoContext {
  DAMAGE
  DAILY_CHECK
  MAINTENANCE
  INVENTORY_REFERENCE
  VEHICLE_REFERENCE
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  role              UserRole  @default(OPERATOR)
  pinHash           String?
  failedPinAttempts Int       @default(0)
  pinLockedAt       DateTime?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  hourlyRate Decimal? @db.Decimal(10, 2)

  checkLogs          CheckLog[]
  dailyChecks        DailyCheck[]
  projectsLed        Project[]         @relation("ProjectLead")
  photos             Photo[]
  alerts             Alert[]
  rigs               Rig[]             @relation("OperatorRigs")
  secondaryRigs      RigOperator[]     @relation("RigSecondaryOperators")
  transfersReceived  TransferRequest[] @relation("TransferTo")
  transfersInitiated TransferRequest[] @relation("TransferBy")

  @@map("users")
}

model Category {
  id        String          @id @default(cuid())
  name      String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  items     InventoryItem[]

  @@map("categories")
}

model Hub {
  id               String            @id @default(cuid())
  name             String
  city             String
  state            String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  items            InventoryItem[]
  maintenanceTasks MaintenanceTask[] @relation("HubTasks")
  repairTasks      MaintenanceTask[] @relation("RepairHub")

  @@map("hubs")
}

model Rig {
  id         String    @id @default(cuid())
  label      String?
  operatorId String
  operator   User      @relation("OperatorRigs", fields: [operatorId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  vehicles           RigVehicle[]
  kits               Kit[]
  outgoingTransfers  TransferRequest[] @relation("FromRig")
  secondaryOperators RigOperator[]
  checkLogs          CheckLog[]

  @@index([operatorId])
  @@index([endedAt])
  @@map("rigs")
}

model RigOperator {
  id         String   @id @default(cuid())
  rigId      String
  operatorId String
  addedAt    DateTime @default(now())

  rig      Rig  @relation(fields: [rigId], references: [id])
  operator User @relation("RigSecondaryOperators", fields: [operatorId], references: [id])

  @@unique([rigId, operatorId])
  @@map("rig_operators")
}

model RigVehicle {
  id         String    @id @default(cuid())
  rigId      String
  vehicleId  String
  rig        Rig       @relation(fields: [rigId], references: [id])
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
  addedAt    DateTime  @default(now())
  addNote    String
  removedAt  DateTime?
  removeNote String?
  photoUrls  String[]  @default([])

  @@index([rigId, removedAt])
  @@map("rig_vehicles")
}

model Kit {
  id        String   @id @default(cuid())
  rigId     String
  rig       Rig      @relation(fields: [rigId], references: [id])
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items KitItem[]

  @@map("kits")
}

model KitItem {
  id              String         @id @default(cuid())
  kitId           String
  inventoryItemId String
  quantity        Int            @default(1)
  inventoryUnitId String?
  kit             Kit            @relation(fields: [kitId], references: [id])
  item            InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  inventoryUnit   InventoryUnit? @relation(fields: [inventoryUnitId], references: [id])
  addedAt         DateTime       @default(now())
  removedAt       DateTime?

  transferItems TransferItem[]

  @@index([kitId])
  @@index([inventoryUnitId])
  @@index([removedAt])
  @@map("kit_items")
}

model TransferRequest {
  id            String         @id @default(cuid())
  fromRigId     String
  fromRig       Rig            @relation("FromRig", fields: [fromRigId], references: [id])
  toOperatorId  String
  toOperator    User           @relation("TransferTo", fields: [toOperatorId], references: [id])
  initiatedById String
  initiatedBy   User           @relation("TransferBy", fields: [initiatedById], references: [id])
  note          String
  photoUrls     String[]       @default([])
  status        TransferStatus @default(PENDING)
  responseNote  String?
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  vehicles TransferVehicle[]
  items    TransferItem[]

  @@map("transfer_requests")
}

model TransferVehicle {
  id                String          @id @default(cuid())
  transferRequestId String
  vehicleId         String
  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id])
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])

  @@map("transfer_vehicles")
}

model TransferItem {
  id                String          @id @default(cuid())
  transferRequestId String
  kitItemId         String
  quantity          Int?
  inventoryUnitId   String?
  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id])
  kitItem           KitItem         @relation(fields: [kitItemId], references: [id])
  inventoryUnit     InventoryUnit?  @relation(fields: [inventoryUnitId], references: [id])

  @@map("transfer_items")
}

model InventoryItem {
  id                String            @id @default(cuid())
  name              String
  category          EquipmentCategory @default(OTHER)
  itemType          String            @default("CONSUMABLE")
  unitId            String?
  sku               String?
  quantity          Int               @default(1)
  expectedQuantity  Int?
  unitCost          Decimal?          @db.Decimal(10, 2)
  reorderUrl        String?
  supplier          String?
  status            EquipmentStatus   @default(AVAILABLE)
  location          String?
  qrCodeId          String            @unique @default(cuid())
  notes             String?
  lowStockThreshold Int?
  categoryId        String?
  hubId             String?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  categoryRef      Category?          @relation(fields: [categoryId], references: [id])
  hub              Hub?               @relation(fields: [hubId], references: [id])
  units            InventoryUnit[]
  checkLogs        CheckLog[]
  photos           Photo[]
  maintenanceTasks MaintenanceTask[]
  projectEquipment ProjectEquipment[]
  kitItems         KitItem[]

  @@index([categoryId])
  @@index([hubId])
  @@index([deletedAt])
  @@map("inventory_items")
}

model InventoryUnit {
  id                     String          @id @default(cuid())
  qrCodeId               String          @unique @default(cuid())
  inventoryItemId        String
  serialNumber           String?
  status                 EquipmentStatus @default(AVAILABLE)
  notes                  String?
  inoperableNotes        String?
  inoperableReportedAt   DateTime?
  inoperableReportedById String?
  deletedAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  kitItems      KitItem[]
  transferItems TransferItem[]
  checkLogs     CheckLog[]

  @@index([inventoryItemId])
  @@index([status])
  @@index([deletedAt])
  @@map("inventory_units")
}

model Vehicle {
  id                  String        @id @default(cuid())
  name                String        @unique
  type                VehicleType
  year                Int?
  makeModel           String?
  vin                 String?       @unique
  licensePlate        String?
  odometer            Int?
  status              VehicleStatus @default(ACTIVE)
  location            String?
  assignedOperatorId  String?
  insuranceExpires    DateTime?
  registrationExpires DateTime?
  qrCodeId            String        @unique @default(cuid())
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  dailyChecks      DailyCheck[]
  maintenanceTasks MaintenanceTask[]
  photos           Photo[]
  rigVehicles      RigVehicle[]
  transferVehicles TransferVehicle[]

  @@map("vehicles")
}

model DailyCheck {
  id            String    @id @default(cuid())
  vehicleId     String
  operatorId    String
  date          DateTime  @db.Date
  site          String?
  odometer      Int?
  checklistJson Json // { itemKey: "yes" | "no" | "na", note?: string }[]
  issues        String?
  passFail      Boolean   @default(true)
  submittedAt   DateTime  @default(now())
  syncedAt      DateTime?

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id])
  operator User    @relation(fields: [operatorId], references: [id])
  photos   Photo[]

  @@unique([vehicleId, date, operatorId])
  @@map("daily_checks")
}

model CheckLog {
  id              String      @id @default(cuid())
  action          CheckAction
  itemId          String
  inventoryUnitId String?
  operatorId      String?
  rigId           String?
  projectId       String?
  fromLocation    String?
  toLocation      String?
  condition       Condition?
  expectedReturn  DateTime?
  actualReturn    DateTime?
  notes           String?
  submittedAt     DateTime    @default(now())
  syncedAt        DateTime?

  item          InventoryItem  @relation(fields: [itemId], references: [id])
  inventoryUnit InventoryUnit? @relation(fields: [inventoryUnitId], references: [id])
  operator      User?          @relation(fields: [operatorId], references: [id])
  rig           Rig?           @relation(fields: [rigId], references: [id])
  project       Project?       @relation(fields: [projectId], references: [id])
  photos        Photo[]

  @@index([itemId])
  @@index([itemId, action])
  @@index([inventoryUnitId])
  @@index([operatorId])
  @@index([rigId])
  @@index([submittedAt])
  @@map("check_logs")
}

model MaintenanceTask {
  id             String            @id @default(cuid())
  vehicleId      String?
  itemId         String?
  taskName       String
  intervalType   IntervalType      @default(DAYS)
  intervalValue  Int               @default(0)
  priority       Priority          @default(MEDIUM)
  lastCompleted  DateTime?
  lastOdometer   Int?
  nextDue        DateTime?
  nextOdometer   Int?
  status         MaintenanceStatus @default(UPCOMING)
  estimatedCost  Decimal?          @db.Decimal(10, 2)
  actualCost     Decimal?          @db.Decimal(10, 2)
  assigneeId     String?
  hubId          String?
  repairHubId    String?
  notes          String?
  completedAt    DateTime?
  isDamageReport Boolean           @default(false)
  repairType     RepairType?
  shopName       String?
  shopAddress    String?
  dateDelivered  DateTime?
  purchaseOrder  String?
  invoiceNumber  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  vehicle   Vehicle?       @relation(fields: [vehicleId], references: [id])
  item      InventoryItem? @relation(fields: [itemId], references: [id])
  hub       Hub?           @relation("HubTasks", fields: [hubId], references: [id])
  repairHub Hub?           @relation("RepairHub", fields: [repairHubId], references: [id])
  photos    Photo[]

  @@map("maintenance_tasks")
}

model Project {
  id        String        @id @default(cuid())
  name      String
  type      ProjectType   @default(CROPLAND)
  location  String?
  startDate DateTime?     @db.Date
  endDate   DateTime?     @db.Date
  status    ProjectStatus @default(PLANNED)
  leadId    String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lead      User?              @relation("ProjectLead", fields: [leadId], references: [id])
  checkLogs CheckLog[]
  equipment ProjectEquipment[]
  rigs      Rig[]

  @@map("projects")
}

model ProjectEquipment {
  projectId String
  itemId    String

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])

  @@id([projectId, itemId])
  @@map("project_equipment")
}

model Alert {
  id          String    @id @default(cuid())
  type        AlertType
  triggeredAt DateTime  @default(now())
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  adminId     String?
  sourceTable String?
  sourceId    String?
  metadata    Json?

  admin User? @relation(fields: [adminId], references: [id])

  @@map("alerts")
}

model Photo {
  id              String       @id @default(cuid())
  url             String
  thumbnailUrl    String?
  context         PhotoContext
  dailyCheckId    String?
  checkLogId      String?
  maintenanceId   String?
  inventoryItemId String?
  vehicleId       String?
  uploadedById    String
  takenAt         DateTime     @default(now())
  gpsLat          Float?
  gpsLng          Float?

  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  dailyCheck      DailyCheck?      @relation(fields: [dailyCheckId], references: [id])
  checkLog        CheckLog?        @relation(fields: [checkLogId], references: [id])
  maintenanceTask MaintenanceTask? @relation(fields: [maintenanceId], references: [id])
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])

  @@map("photos")
}

model InviteToken {
  id        String    @id @default(cuid())
  email     String
  role      UserRole
  name      String
  // Security: token is generated with a CSPRNG (crypto.randomBytes) in the
  // invite-create route — NOT cuid(), which is not cryptographically random
  // and is guessable on a public, throttled endpoint that can mint accounts.
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String // admin user id

  @@map("invite_tokens")
}

// Wave 1: dedup store for offline replay of non-idempotent writes.
// Written/read via raw SQL in src/lib/idempotency.ts (no client coupling).
model IdempotencyKey {
  key          String   @id
  scope        String
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("idempotency_key")
}
