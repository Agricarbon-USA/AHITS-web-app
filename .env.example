# ─────────────────────────────────────────────
# DATABASE — provided after provisioning
# ─────────────────────────────────────────────
# Prisma connection string (Supabase transaction pooler — port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─────────────────────────────────────────────
# SUPABASE — for Auth, Storage, Realtime
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
# 32+ char random string for PIN session signing
PIN_SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_YOUR_KEY"
EMAIL_FROM="AHITS <noreply@agricarbon.com>"
ADMIN_EMAIL="ops@agricarbon.com"

# ─────────────────────────────────────────────
# GCP (populated by GitHub Actions secrets)
# ─────────────────────────────────────────────
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
GCP_SERVICE_ACCOUNT_KEY=""   # JSON key (base64 in CI)
