# ─────────────────────────────────────────────
# DATABASE — provided after provisioning
# ─────────────────────────────────────────────
# Prisma connection string (Supabase transaction pooler — port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# NOTE: Do NOT put a test database here. Tests use their own isolated DB —
# see .env.test.example and `make test`. The test suite never touches this DB.

# ─────────────────────────────────────────────
# SUPABASE — for Auth, Storage, Realtime
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
# 32+ char random string for PIN session signing
PIN_SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Number of trusted reverse-proxy hops in front of the app, used to pick the
# real client IP from X-Forwarded-For for rate limiting (CR-4). Leave at 1 for
# direct Cloud Run (run.app); set to 2 if the service sits behind a Google
# external HTTPS load balancer. Default: 1.
RATE_LIMIT_TRUSTED_HOPS="1"

# ─────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_YOUR_KEY"
EMAIL_FROM="AHITS <noreply@agricarbon.com>"
# Non-prod email guard (H-NOTIF3): set EMAIL_SANDBOX=true on EVERY non-production
# environment so real shops/hubs/operators are never emailed. With EMAIL_SANDBOX_TO
# set, messages are redirected to that test inbox (original recipients tagged into
# the subject); without it, sends are skipped and logged. Leave both unset in prod.
EMAIL_SANDBOX="false"
EMAIL_SANDBOX_TO=""

# ─────────────────────────────────────────────
# CRON — notification dispatcher (Wave F)
# ─────────────────────────────────────────────
# Shared secret the scheduler presents to /api/cron/dispatch as
# `Authorization: Bearer <CRON_SECRET>` (or `?key=<CRON_SECRET>`).
# Generate with: openssl rand -hex 32
CRON_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"

# IANA timezone name used to convert "now" to a local date and wall-clock
# hour when evaluating the daily-check cutoff. Must match the timezone
# your field operators work in. Default: America/Chicago (US Central).
APP_TIMEZONE="America/Chicago"

# ─────────────────────────────────────────────
# GCP (populated by GitHub Actions secrets)
# ─────────────────────────────────────────────
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
GCP_SERVICE_ACCOUNT_KEY=""   # JSON key (base64 in CI)
